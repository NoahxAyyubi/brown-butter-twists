{
  "name": "brown-butter-twists",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon server/index.js",
    "dev:client": "vite --host 0.0.0.0 --port 5173 client",
    "build": "vite build client",
    "start": "prisma db push && node prisma/seed.js && node server/index.js",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push",
    "seed": "node prisma/seed.js",
    "email:keepalive": "node scripts/brevo-keepalive.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@vitejs/plugin-react": "^6.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.8",
    "prisma": "^5.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^8.0.14"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "nodemon": "^3.1.7"
  }
}
